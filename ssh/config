# On a machine I'm sitting at, use the local 1Password agent.
# Inside an SSH session, fall back to $SSH_AUTH_SOCK (the forwarded agent).
Match !exec "printenv SSH_CONNECTION >/dev/null"
    IdentityAgent ~/.1password/agent.sock

Host *
    ServerAliveInterval 5
    ServerAliveCountMax 1
    StrictHostKeyChecking ask
    AddKeysToAgent confirm
    UpdateHostKeys no

# Aliases only say *where* to connect.
# Per-host behavior lives in the Match blocks below,
# which match on the resolved host and user
# (the same way 1Password's bookmarks pick keys),
# so they apply however the host was addressed.
Host odroid
	HostName 176.106.38.32
	Port 25001
	User bartek

Host ubuntu-tiny
	HostName pacia.tech
	User charlie

Match host 176.106.38.32 user bartek
	Port 25001
	ForwardAgent yes
	RemoteForward /home/bartek/.1password/agent.sock /home/bartek/.1password/agent.sock

Match host pacia.tech user charlie
	ForwardAgent yes
	RemoteForward /home/charlie/.1password/agent.sock /home/bartek/.1password/agent.sock

Match all
Include ~/.ssh/1Password/config
