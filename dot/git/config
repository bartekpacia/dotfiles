[user]
	name = Bartek Pacia
	email = barpac02@gmail.com
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM0XGjV2GkSq7+K+l5SgIFVStXdZPT9ItmBHnizJW30X
	useConfigOnly = true
[core]
	fsmonitor = true
[commit]
	gpgsign = true
[pull]
	ff = only
[rebase]
	autoSquash = true
[tag]
	forceSignAnnotated = true
[diff]
	wsErrorHighlight = all
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[init]
	defaultBranch = master
[alias]
	l1 = log --date=short --color=always --format='%C(green)%ad %C(auto)%h %C(blue)%<(15,trunc)%an %C(auto)%<(65,trunc)%s%d%C(reset)'
	logsig = log --date=short --format='%G? %C(green)%ad %C(auto)%h %C(blue)%<(15,trunc)%an %C(auto)%<(65,trunc)%s%d%C(reset)'
[transfer]
	fsckObjects = true
[safe]
	bareRepository = explicit
